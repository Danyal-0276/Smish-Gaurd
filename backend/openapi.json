              "message": {
                "type": "string",
                "maxLength": 300
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Registration": {
        "type": "object",
        "properties": {
          "app_version": {
            "type": "string",
            "maxLength": 30,
            "pattern": "^[0-9A-Za-z._-]{1,30}$"
          },
          "consent_version": {
            "type": "string",
            "enum": [
              "2026-10-22",
              "2026-10-23"
            ]
          },
          "cloud_analysis_consent": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "app_version",
          "consent_version",
          "cloud_analysis_consent"
        ],
        "additionalProperties": false
      },
      "Credential": {
        "type": "object",
        "properties": {
          "credential": {
            "type": "string",
            "description": "One-time installation bearer secret. Store only in Keystore-backed storage; never log."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "installation_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "credential",
          "expires_at",
          "installation_id"
        ],
        "additionalProperties": false
      },
      "AnalysisInput": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "description": "Non-whitespace JSON string. Body must also fit 32 KiB."
          },
          "cloud_analysis_consent": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "text",
          "cloud_analysis_consent"
        ],
        "additionalProperties": false
      },
      "FeedbackInput": {
        "type": "object",
        "properties": {
          "client_event_id": {
            "type": "string",
            "format": "uuid"
          },
          "model_version": {
            "type": "string",
            "maxLength": 100
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "review",
              "high"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "false_positive",
              "false_negative",
              "unclear"
            ]
          },
          "feedback_consent": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "client_event_id",
          "model_version",
          "risk",
          "reason",
          "feedback_consent"
        ],
        "additionalProperties": false
      },
      "Empty": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "CompletedAnalysis": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "backend_model"
            ]
          },
          "model_version": {
            "type": "string",
            "maxLength": 100
          },
          "coverage": {
            "type": "string",
            "maxLength": 2000
          },
          "safety_guarantee": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "completed"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "review",
              "high"
            ]
          },
          "policy_version": {
            "type": "string",
            "maxLength": 100
          },
          "model_estimate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "indicators": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 2000
                },
                "description": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "title",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "domains": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 253
            }
          },
          "advice": {
            "type": "string",
            "maxLength": 2000
          },
          "indicator_note": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "request_id",
          "mode",
          "model_version",
          "coverage",
          "safety_guarantee",
          "status",
          "risk",
          "policy_version",
          "model_estimate",
          "indicators",
          "domains",
          "advice",
          "indicator_note"
        ],
        "additionalProperties": false
      },
      "UnsupportedAnalysis": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "backend_model"
            ]
          },
          "model_version": {
            "type": "string",
            "maxLength": 100
          },
          "coverage": {
            "type": "string",
            "maxLength": 2000
          },
          "safety_guarantee": {
            "type": "boolean",
            "enum": [
