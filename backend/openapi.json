            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 60
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "InstallationBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-installation opaque credential; not a human account or a JWT."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
