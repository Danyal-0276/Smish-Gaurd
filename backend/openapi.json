            "type": "string",
            "format": "uuid"
          },
          "client_event_id": {
            "type": "string",
            "format": "uuid"
          },
          "model_version": {
            "type": "string",
            "maxLength": 100
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "review",
              "high"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 20
          },
          "status": {
            "type": "string",
            "enum": [
