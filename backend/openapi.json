          },
          "status": {
            "type": "string",
            "enum": [
              "unsupported"
            ]
          },
          "risk": {
            "type": "string",
            "nullable": true,
            "enum": [
              null
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "request_id",
          "mode",
          "model_version",
          "coverage",
          "safety_guarantee",
          "status",
          "risk",
          "message"
        ],
        "additionalProperties": false
      },
      "AnalysisResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/CompletedAnalysis"
          },
          {
            "$ref": "#/components/schemas/UnsupportedAnalysis"
          }
