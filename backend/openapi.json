          "previous": {
            "type": "string",
            "nullable": true
          },
          "results": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Feedback"
            }
          }
        },
        "required": [
          "next",
          "previous",
          "results"
        ],
        "additionalProperties": false
      },
      "Lesson": {
        "type": "object",
        "properties": {
