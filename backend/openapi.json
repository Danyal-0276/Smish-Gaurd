            "type": "string",
            "maxLength": 60
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "maxLength": 300
          },
          "category": {
            "type": "string",
            "maxLength": 60
          },
